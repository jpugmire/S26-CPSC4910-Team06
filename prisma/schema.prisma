generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  User_ID           Int                 @id @default(autoincrement())
  Username          String              @db.VarChar(30) @unique
  Password          String              @db.VarChar(255)
  Status            String              @db.VarChar(1)
  Date_Added        DateTime            @default(now()) @db.DateTime(0)
  Date_Inactive     DateTime?           @db.DateTime(0)
  User_Type         String              @db.VarChar(1)
  Admin             Admin?
  Audit             Audit[]
  Driver            Driver?
  Point_Transaction Point_Transaction[]
  Sponsor           Sponsor?
}

model Driver {
  User_ID     Int          @id
  Point_Count Int
  Org_ID      Int?
  User        User         @relation(fields: [User_ID], references: [User_ID], onDelete: NoAction, onUpdate: NoAction, map: "Driver_ibfk_1")
  Sponsor_Org Sponsor_Org? @relation(fields: [Org_ID], references: [Org_ID], onDelete: NoAction, onUpdate: NoAction, map: "fk_Org_Id")

  @@index([Org_ID], map: "fk_Org_Id")
}

model Sponsor {
  User_ID     Int          @id
  Org_ID      Int?
  User        User         @relation(fields: [User_ID], references: [User_ID], onDelete: NoAction, onUpdate: NoAction, map: "Sponsor_ibfk_1")
  Sponsor_Org Sponsor_Org? @relation(fields: [Org_ID], references: [Org_ID], onDelete: NoAction, onUpdate: NoAction, map: "fk_Org_Id_Sponsor")

  @@index([Org_ID], map: "fk_Org_Id_Sponsor")
}

model Admin {
  User_ID Int  @id
  User    User @relation(fields: [User_ID], references: [User_ID], onDelete: NoAction, onUpdate: NoAction, map: "Admin_ibfk_1")
}

model Audit {
  Audit_ID     Int      @id @default(autoincrement())
  User_ID      Int
  Date_Created DateTime @default(now()) @db.DateTime(0)
  User         User     @relation(fields: [User_ID], references: [User_ID], onDelete: NoAction, onUpdate: NoAction, map: "Audit_ibfk_1")

  @@index([User_ID], map: "User_ID")
}

model Catalog {
  Catalog_ID      Int               @id @default(autoincrement())
  Org_ID          Int
  Catalog_Listing Int?
  Sponsor_Org     Sponsor_Org       @relation(fields: [Org_ID], references: [Org_ID], onDelete: NoAction, onUpdate: NoAction, map: "Catalog_ibfk_1")
  Catalog_Items   Catalog_Listing[]

  @@index([Org_ID], map: "Org_ID")
}

model Catalog_Item {
  Item_ID           Int                 @id @default(autoincrement())
  Item_Name         String              @db.VarChar(30)
  Catalog_Listing   Catalog_Listing[]
  Point_Transaction Point_Transaction[]
}

model Catalog_Listing {
  Catalog_ID   Int
  Item_ID      Int
  Catalog      Catalog      @relation(fields: [Catalog_ID], references: [Catalog_ID], onDelete: Cascade, map: "fk_cci_catalog")
  Catalog_Item Catalog_Item @relation(fields: [Item_ID], references: [Item_ID], onDelete: Cascade, map: "fk_cci_item")

  @@id([Catalog_ID, Item_ID])
  @@index([Item_ID], map: "fk_cci_item")
}

model Point_Transaction {
  Transaction_ID   Int          @id @default(autoincrement())
  Price            Decimal      @db.Decimal(8, 2)
  Transaction_Date DateTime     @default(now()) @db.DateTime(0)
  User_ID          Int
  Item_ID          Int
  User             User         @relation(fields: [User_ID], references: [User_ID], onDelete: NoAction, onUpdate: NoAction, map: "Point_Transaction_ibfk_1")
  Catalog_Item     Catalog_Item @relation(fields: [Item_ID], references: [Item_ID], onDelete: NoAction, onUpdate: NoAction, map: "Point_Transaction_ibfk_2")

  @@index([Item_ID], map: "Item_ID")
  @@index([User_ID], map: "User_ID")
}

model Sponsor_Org {
  Org_ID   Int       @id @default(autoincrement())
  Org_Name String    @db.VarChar(30)
  Catalog  Catalog[]
  Driver   Driver[]
  Sponsor  Sponsor[]
}

model Version {
  VersionID      Int      @id @default(autoincrement())
  VersionCreated DateTime @default(now()) @db.DateTime(0)
  VersionNum     Int
}
